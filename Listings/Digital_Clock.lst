LOC  OBJ            LINE     SOURCE

                       1     ; ============================================================
                       2     ; AT89S52 DIGITAL ALARM CLOCK WITH TM1637 DISPLAY
                       3     ; Crystal frequency: 11.0592 MHz
                       4     ;
                       5     ; CONNECTIONS
                       6     ; ------------------------------------------------------------
                       7     ; TM1637 CLK       -> P1.0
                       8     ; TM1637 DIO       -> P1.1
                       9     ;
                      10     ; SET push-button  -> P3.2  (other terminal to GND)
                      11     ; UP push-button   -> P3.3  (other terminal to GND)
                      12     ; ALARM button     -> P3.4  (other terminal to GND)
                      13     ;
                      14     ; Active buzzer    -> P3.5  (other terminal to GND)
                      15     ; Use a transistor driver if your buzzer needs more current.
                      16     ;
                      17     ; BUTTON OPERATION
                      18     ; ------------------------------------------------------------
                      19     ; SET once         : Set clock hour
                      20     ; SET twice        : Set clock minute
                      21     ; SET three times  : Set alarm hour
                      22     ; SET four times   : Set alarm minute
                      23     ; SET five times   : Return to normal clock display
                      24     ;
                      25     ; UP               : Increase the selected value
                      26     ; ALARM            : Enable/disable alarm
                      27     ; ALARM while ring : Silence buzzer
                      28     ; ============================================================
                      29     
  0090                30     CLK             BIT     P1.0
  0091                31     DIO             BIT     P1.1
                      32     
  00B2                33     SET_KEY         BIT     P3.2
  00B3                34     UP_KEY          BIT     P3.3
  00B4                35     ALARM_KEY       BIT     P3.4
  00B5                36     BUZZER          BIT     P3.5
                      37     
                      38     ; ------------------------------------------------------------
                      39     ; RAM LOCATIONS
                      40     ; ------------------------------------------------------------
  0030                41     SEC             EQU     30H
  0031                42     MINUTE          EQU     31H
  0032                43     HOUR            EQU     32H
  0033                44     TICK50          EQU     33H
                      45     
  0034                46     AL_HOUR         EQU     34H
  0035                47     AL_MINUTE       EQU     35H
  0036                48     ALARM_EN        EQU     36H
  0037                49     SET_MODE        EQU     37H
  0038                50     RINGING         EQU     38H
  0039                51     ALARM_LATCH     EQU     39H
  003A                52     BEEP_TICK       EQU     3AH
                      53     
  003B                54     DISP_HOUR       EQU     3BH
  003C                55     DISP_MINUTE     EQU     3CH
  003D                56     DISP_SEC        EQU     3DH
                      57     
A51 MACRO ASSEMBLER  DIGITAL_CLOCK                                                        09/27/2026 00:36:57 PAGE     2

                      58     ; SET_MODE values:
                      59     ; 00H = Normal display
                      60     ; 01H = Set clock hour
                      61     ; 02H = Set clock minute
                      62     ; 03H = Set alarm hour
                      63     ; 04H = Set alarm minute
                      64     
                      65     
                      66     ; ============================================================
                      67     ; RESET VECTOR
