                      63     
                      64     ; Set input pins high: buttons connect pin to GND when pressed
0054 D2B2             65                     SETB    SET_KEY
0056 D2B3             66                     SETB    UP_KEY
0058 D2B4             67                     SETB    ALARM_KEY
005A C2B5             68                     CLR     BUZZER
                      69     
005C D290             70                     SETB    CLK
005E D291             71                     SETB    DIO
                      72     
                      73     ; Timer 0, mode 1
