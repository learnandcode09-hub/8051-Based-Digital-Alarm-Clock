LOC  OBJ            LINE     SOURCE

                       1     ; ============================================================
                       2     ; AT89S52 Alarm Clock with TM1637 4-digit display
                       3     ; Crystal: 11.0592 MHz
                       4     ;
                       5     ; P1.0 = TM1637 CLK
                       6     ; P1.1 = TM1637 DIO
                       7     ; P3.2 = SET button, active LOW
                       8     ; P3.3 = UP button, active LOW
                       9     ; P3.4 = ALARM enable / silence button, active LOW
                      10     ; P3.5 = Active buzzer output, active HIGH
                      11     ; ============================================================
                      12     
  0090                13     CLK             BIT     P1.0
  0091                14     DIO             BIT     P1.1
                      15     
  00B2                16     SET_KEY         BIT     P3.2
  00B3                17     UP_KEY          BIT     P3.3
  00B4                18     ALARM_KEY       BIT     P3.4
  00B5                19     BUZZER          BIT     P3.5
                      20     
  0030                21     SEC             EQU     30H
  0031                22     MINUTE          EQU     31H
  0032                23     HOUR            EQU     32H
  0033                24     TICK50          EQU     33H
                      25     
  0034                26     AL_HOUR         EQU     34H
  0035                27     AL_MINUTE       EQU     35H
  0036                28     ALARM_EN        EQU     36H
  0037                29     SET_MODE        EQU     37H    ; 0=clock, 1=set alarm hour, 2=set alarm minute
  0038                30     RINGING         EQU     38H
  0039                31     ALARM_LATCH     EQU     39H
  003A                32     BEEP_TICK       EQU     3AH
                      33     
  003B                34     DISP_HOUR       EQU     3BH
  003C                35     DISP_MINUTE     EQU     3CH
  003D                36     DISP_SEC        EQU     3DH
                      37     
0000                  38                     ORG     0000H
0000 020030           39                     LJMP    MAIN
                      40     
000B                  41                     ORG     000BH
000B 02007A           42                     LJMP    TIMER0_ISR
                      43     
0030                  44                     ORG     0030H
                      45     
0030                  46     MAIN:
0030 75815F           47                     MOV     SP,#5FH
                      48     
                      49     ; Clock initial time: 12:00:00
0033 75320C           50                     MOV     HOUR,#12D
0036 753100           51                     MOV     MINUTE,#00D
0039 753000           52                     MOV     SEC,#00D
003C 753300           53                     MOV     TICK50,#00D
                      54     
